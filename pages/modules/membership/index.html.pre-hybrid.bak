                                            <option${normalizeAgmaPaperSize(data.paperSize || data.paper || "A4") === "Short" ? " selected" : ""}>Short</option>
                                            <option${normalizeAgmaPaperSize(data.paperSize || data.paper || "A4") === "Long" ? " selected" : ""}>Long</option>
                                        </select>
