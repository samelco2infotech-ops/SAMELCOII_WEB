                                                            <select data-agma-column-weight="${escapeHtml(column.key)}">
                                                                <option${String(currentWeights[column.key] || "normal") === "normal" ? " selected" : ""}>Regular</option>
                                                                <option${String(currentWeights[column.key] || "normal") === "bold" ? " selected" : ""}>Bold</option>
                                                            </select>
                                                        </div>
                                                    </label>
                                                `;
                                            }).join("")}
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="agma-legacy-table">
                                <table class="modal-table">
                                    <thead>
                                        <tr><th>#</th><th>MEMID</th><th>Account</th><th>Name</th><th>Address</th><th>RateCode</th><th>Source</th></tr>
                                    </thead>
                                    <tbody data-agma-list>
                                        <tr><td colspan="7">Loading AGMA records...</td></tr>
                                    </tbody>
                                </table>
                            </div>

                            <div class="agma-legacy-summary">
                                <span class="report-chip" data-agma-page-info>Page 1 / 1</span>
                                <span class="report-chip report-chip-muted" data-agma-summary>0 customers</span>
                            </div>

                            <div class="agma-legacy-footer">
                                <div class="agma-legacy-chipbar">
                                    ${AGMA_RATE_CODE_OPTIONS.map((option) => `<button class="agma-class-chip is-active" data-agma-class-chip="${escapeHtml(option.label)}" data-agma-rate-chip="${escapeHtml(option.code)}" type="button">${escapeHtml(option.label)}</button>`).join("")}
                                </div>
                                <div class="agma-pager" data-agma-pager></div>
                                <div class="modal-actions">
                                    <button class="modal-action-btn modal-action-btn-secondary" data-agma-print type="button">Print</button>
                                    <button class="modal-action-btn" data-agma-export-excel type="button" aria-label="Export Excel" title="Export Excel"><i class="fa fa-file-excel-o" aria-hidden="true"></i></button>
                                </div>
                            </div>

                            <div class="agma-print-modal" data-agma-print-modal>
                                <section class="agma-print-card">
                                    <div class="agma-print-head">
                                        <h4>Print Preview — AGMA Roster</h4>
                                        <div class="agma-print-actions">
                                            <button class="modal-action-btn" data-agma-print-cancel type="button">Cancel</button>
                                            <button class="modal-action-btn modal-action-btn-secondary" data-agma-print-confirm type="button" disabled>Print</button>
                                        </div>
                                    </div>
                                    <iframe class="agma-print-frame" data-agma-print-frame title="AGMA roster preview"></iframe>
                                </section>
                            </div>
                        </div>
                    `;
                }
                return `
                    <div class="report-legacy-shell">
                        <div class="report-legacy-topbar">
                            <div class="left">
                                <span class="checkbox" aria-hidden="true"></span>
                                <span>Election form</span>
                            </div>
                            <button class="close" type="button" data-report-close aria-label="Close report">X</button>
                        </div>

                                                <div class="report-legacy-toolbar">
                            <label class="modal-field report-search-field">
                                <span>Search Name</span>
                                <input data-report-search type="text" placeholder="Type name, account, area, or book" />
                            </label>
                            <label class="modal-field">
                                <span>Area</span>
                                <select data-report-area>
                                    ${["ALL", ...getCurrentAreaOptions()].map((option) => `<option${option === String(form.elements.area?.value || data.area || "001 - CATBALOGAN") ? " selected" : ""}>${escapeHtml(option)}</option>`).join("")}
                                </select>
                            </label>
                            <label class="modal-field">
                                <span>Barangay</span>
                                <select data-report-book>
                                    ${["ALL", ...getCurrentBookOptions()].map((option) => `<option${option === String(form.elements.barangay?.value || data.barangay || "ALL") ? " selected" : ""}>${escapeHtml(option)}</option>`).join("")}
                                </select>
                            </label>
                            <label class="modal-field">
                                <span>Columns</span>
                                <select data-report-columns>
                                    ${["# AC", "Areas", "Sample Accounts", "Remark"].map((option) => `<option${option === "# AC" ? " selected" : ""}>${escapeHtml(option)}</option>`).join("")}
                                </select>
                            </label>
                            <button class="report-icon-btn" data-report-refresh type="button" aria-label="Refresh">+</button>
                            <button class="report-icon-btn blue" data-report-print type="button" aria-label="Print">&#9633;</button>
                            <button class="report-icon-btn blue" data-report-clear type="button" aria-label="Clear">&#10005;</button>
                        </div>

                        <div class="report-legacy-table">
                            <table class="report-grid">
                                <thead>
                                    <tr>
                                        <th style="width: 30%;">Primary Name</th>
                                        <th style="width: 10%;"># AC</th>
                                        <th style="width: 22%;">Areas</th>
                                        <th style="width: 28%;">Sample Accounts</th>
                                        <th style="width: 10%;">Remark</th>
                                    </tr>
                                </thead>
                                <tbody data-report-list>
                                    <tr><td colspan="5">Loading report rows...</td></tr>
                                </tbody>
                            </table>
                        </div>

                        <div class="report-legacy-summary">
                            <span class="report-chip" data-report-page-info>Page 1 / 1</span>
                            <span class="report-chip report-chip-muted" data-report-summary>0 records</span>
                        </div>

                        <div class="report-legacy-footer">
                            <div class="report-legacy-chips">
                                ${["Residential", "Commercial", "Street Light", "Public Building", "Industrials"].map((option) => `<button class="report-class-chip${option === reportActiveClass ? " is-active" : ""}" data-report-class-chip="${escapeHtml(option)}" type="button">${escapeHtml(option)}</button>`).join("")}
                            </div>
                            <div class="modal-actions">
                                <button class="modal-action-btn" data-report-prev type="button"><<</button>
                                <button class="modal-action-btn" data-report-next type="button">>></button>
                            </div>
                        </div>
                    </div>

                    <div class="report-group-modal" data-report-group-modal>
                        <section class="report-group-card">
                            <div class="report-group-head">
                                <div>
                                    <h4 data-report-group-title>Group Detail</h4>
                                    <div class="report-group-subtitle" data-report-group-subtitle>Click a group to inspect matching accounts.</div>
                                </div>
                                <button class="close" type="button" data-report-group-close aria-label="Close group detail">X</button>
                            </div>
                            <div class="report-group-toolbar">
                                <label class="modal-field">
                                    <span>Add Account No</span>
                                    <input data-report-group-add-account placeholder="Enter account number" />
                                </label>
                                <button class="modal-action-btn" data-report-group-add type="button">ADD</button>
                            </div>
                            <div class="report-group-list-wrap">
                                <table class="modal-table">
                                    <thead>
                                        <tr><th>Account</th><th>Name</th><th>Area</th><th>Book</th><th></th></tr>
                                    </thead>
                                    <tbody data-report-group-list>
                                        <tr><td colspan="5">Select a group row to see the accounts inside it.</td></tr>
                                    </tbody>
                                </table>
                            </div>
                            <div class="modal-actions">
                                <span class="report-chip" data-report-group-count>0 accounts</span>
                                <button class="modal-action-btn" data-report-group-done type="button">Done</button>
                            </div>
                        </section>
                    </div>
                `;
            }

            async function loadPendingPayments() {
                const list = toolBody.querySelector("[data-pp-list]");
                if (!list) return;
                list.innerHTML = `<tr><td colspan="6">Loading...</td></tr>`;
                try {
                    const response = await membershipFetch(`${MEMBERSHIP_API}?action=pending_payments`, { credentials: "same-origin" });
                    const result = await response.json();
                    const items = Array.isArray(result.items) ? result.items : [];
                    if (!items.length) {
                        list.innerHTML = `<tr><td colspan="6">No pending payments.</td></tr>`;
                        return;
                    }
                    list.innerHTML = items.map((item) => `
                        <tr>
                            <td>${escapeHtml(item.accountNumber || "")}</td>
                            <td>${escapeHtml(item.fullName || "")}</td>
                            <td>${escapeHtml(item.area || "")}</td>
                            <td>${Number(item.totalAmount || 0).toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</td>
                            <td>${escapeHtml(item.dateSaved || "")}</td>
                            <td><button class="jo-btn" data-mark-paid="${escapeHtml(item.accountNumber || "")}" type="button">Mark Paid</button></td>
                        </tr>
                    `).join("");
                } catch (error) {
                    list.innerHTML = `<tr><td colspan="6">Unable to load pending payments.</td></tr>`;
                }
            }

            // ponytail: window.confirm/alert, not a custom modal — this action flips a payment
            // record's status ('2' -> '7'), so it needs a hard stop before firing, and this panel
            // has no toast/message slot of its own to reuse for the result. Swap for the app's
            // modal system if one gets added to this panel later.
            async function markFeesPaidUi(accountNumber) {
                if (!accountNumber) return;
                if (!window.confirm(`Mark ${accountNumber} as paid?`)) return;
                try {
                    const response = await membershipFetch(`${MEMBERSHIP_API}?action=mark_fees_paid`, {
                        method: "POST",
                        credentials: "same-origin",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({ accountNumber })
                    });
                    const result = await response.json();
                    if (!response.ok || result.ok === false) {
                        throw new Error(result.message || "Unable to mark as paid.");
                    }
                    loadPendingPayments();
                } catch (error) {
                    window.alert(error.message || "Unable to mark as paid.");
                }
            }

            async function openToolModal(name) {
                toolTitle.textContent = name === "Agma" ? "AGMA" : name;
                let modalHtml = toolHtml(name);
                if (name === "Agma") {
                    const current = values();
                    agmaPage = 1;
                    agmaTotalPages = 1;
                    agmaTotal = 0;
                    if (!String(current.accountNumber || "").trim() || !String(current.memberId || "").trim()) {
                        window.setTimeout(() => generateIds(true).catch(() => null), 0);
                    }
                }
                toolBody.innerHTML = modalHtml;
                toolModal.classList.toggle("job-order-open", name === "Job Order");
                if (name === "Fees") {
                    updateFeesTotals();
                    loadFeesFromServer();
                }
                if (name === "Pending Payments") {
                    loadPendingPayments();
                }
                if (name === "Job Order") {
                    const statusSelect = toolBody.querySelector("[data-jo-status]");
                    const monthSelect = toolBody.querySelector("[data-jo-month]");
                    const areaSelect = toolBody.querySelector("[data-jo-area]");
                    if (statusSelect) statusSelect.value = "PENDING";
                    if (monthSelect) monthSelect.value = "0";
                    if (areaSelect) areaSelect.value = "ALL";
                    loadJobOrders();
                }
                if (name === "Profile Picture Member") {
                    window.setTimeout(() => profileInitModal(), 0);
                }
                if (name === "Report") {
                    reportPage = 1;
                    reportActiveClass = "Residential";
                    window.setTimeout(() => loadReportRows(), 0);
                }
                if (name === "Agma") {
                    const savedAgmaSettings = readAgmaSettings();
                    applyAgmaSettings();
                    syncAgmaSelectionsToMain();
                    agmaSelectedRateCodes = Array.isArray(savedAgmaSettings.rateCodes) && savedAgmaSettings.rateCodes.length
                        ? new Set(savedAgmaSettings.rateCodes.map((value) => normalizeAgmaRateCode(value)).filter(Boolean))
                        : new Set(AGMA_RATE_CODE_OPTIONS.map((item) => item.code));
                    syncAgmaRateChipState();
                    const agmaAreaSelect = toolBody.querySelector("[data-agma-area]");
                    const agmaBookSelect = toolBody.querySelector("[data-agma-book]");
                    const agmaArea = normalizeAgmaAreaValue(agmaAreaSelect?.value || form.elements.area?.value || "") || "001";
                    window.setTimeout(() => loadAgmaBookOptions(agmaArea, agmaBookSelect?.value || ""), 0);
                    agmaSearchTerm = String(savedAgmaSettings.search || toolBody.querySelector("[data-agma-search]")?.value || "").trim();
                    window.setTimeout(() => loadAgmaRecords(1), 0);
                }
                toolModal.classList.toggle("agma-open", name === "Agma");
                document.body.classList.add("member-tool-open");
                toolModal.classList.add("open");
                toolModal.setAttribute("aria-hidden", "false");
            }

            function closeToolModal() {
                movedApproverResultsElements.forEach((el) => { if (el.parentNode) el.parentNode.removeChild(el); });
                movedApproverResultsElements = [];
                if (toolModal.classList.contains("agma-open")) {
                    try {
                        captureAgmaSettings();
                    } catch (_error) {}
                }
                stopProfileCamera();
                profilePhotoBlob = null;
                if (profilePhotoUrl) {
                    URL.revokeObjectURL(profilePhotoUrl);
                    profilePhotoUrl = "";
                }
                toolModal.classList.remove("job-order-open");
                window.clearInterval(joTimingTimer);
                toolModal.classList.remove("agma-open");
                document.body.classList.remove("member-tool-open");
                currentJobOrderDetail = null;
                toolModal.classList.remove("open");
                toolModal.setAttribute("aria-hidden", "true");
            }

            document.querySelectorAll("[data-member-tool]").forEach((button) => {
                button.addEventListener("click", () => {
                    openToolModal(button.dataset.memberTool).catch((error) => {
                        document.getElementById("save-message").textContent = error?.message || "Unable to open tool.";
                    });
                });
            });
            document.getElementById("member-tool-close-btn").addEventListener("click", closeToolModal);
            toolBody.addEventListener("click", (event) => {
                if (event.target.closest("[data-jo-close]")) {
                    closeToolModal();
                }

                if (event.target.closest("[data-pp-close]")) {
                    closeToolModal();
                }
                if (event.target.closest("[data-pp-refresh]")) {
                    loadPendingPayments();
                }
                const markPaidBtn = event.target.closest("[data-mark-paid]");
                if (markPaidBtn) {
                    markFeesPaidUi(markPaidBtn.getAttribute("data-mark-paid"));
                }

                const agmaChip = event.target.closest("[data-agma-class-chip]");
                if (agmaChip) {
                    const nextClass = String(agmaChip.getAttribute("data-agma-class-chip") || "").trim();
                    const nextCode = normalizeAgmaRateCode(nextClass);
                    if (!nextCode) return;
                    if (agmaSelectedRateCodes.has(nextCode)) {
                        if (agmaSelectedRateCodes.size > 1) {
                            agmaSelectedRateCodes.delete(nextCode);
                        }
                    } else {
                        agmaSelectedRateCodes.add(nextCode);
                    }
                    syncAgmaRateChipState();
                    captureAgmaSettings();
                    agmaPage = 1;
                    loadAgmaRecords(1);
                    return;
                }

                const reportGroupRow = event.target.closest("[data-report-group-key]");
                if (reportGroupRow) {
                    openReportGroupDetail(reportGroupRow.getAttribute("data-report-group-key") || "");
                    return;
                }

                if (event.target.closest("[data-report-group-close]")) {
                    closeReportGroupDetail();
                    return;
                }

                if (event.target.closest("[data-report-group-done]")) {
                    closeReportGroupDetail();
                    return;
                }

                const reportGroupRemove = event.target.closest("[data-report-group-remove]");
                if (reportGroupRemove && activeReportGroupKey) {
                    const account = String(reportGroupRemove.getAttribute("data-report-group-remove") || "").trim();
                    if (!account) return;
                    updateReportGroupOverride(activeReportGroupKey, (draft) => {
                        if (!draft.exclude.includes(account)) draft.exclude.push(account);
                        draft.include = draft.include.filter((item) => item !== account);
                        return draft;
                    });
                    activeReportGroupRows = resolveReportGroupAccounts(activeReportGroupKey, reportSourceRows);
                    renderReportGroupModal();
                    loadReportRows();
                    return;
                }

                const reportGroupAddBtn = event.target.closest("[data-report-group-add]");
                if (reportGroupAddBtn && activeReportGroupKey) {
                    const input = toolBody.querySelector("[data-report-group-add-account]");
                    const account = String(input?.value || "").trim();
                    if (!account) return;
                    const exists = (reportSourceRows || []).find((row) => String(row.accountNumber || "").trim() === account);
                    if (!exists) {
                        document.getElementById("save-message").textContent = `Account ${account} was not found in the loaded membership data.`;
                        return;
                    }
                    updateReportGroupOverride(activeReportGroupKey, (draft) => {
                        if (!draft.include.includes(account)) draft.include.push(account);
                        draft.exclude = draft.exclude.filter((item) => item !== account);
                        return draft;
                    });
                    activeReportGroupRows = resolveReportGroupAccounts(activeReportGroupKey, reportSourceRows);
                    renderReportGroupModal();
                    loadReportRows();
                    return;
                }
            });

            toolBody.addEventListener("change", async (event) => {
                const target = event.target;
                if (!(target instanceof HTMLSelectElement)) return;
                if (target.matches("[data-agma-area]")) {
                    syncAgmaSelectionsToMain();
                    const area = normalizeAgmaAreaValue(target.value) || String(target.value || "").trim();
                    const currentBook = normalizeAgmaBookValue(toolBody.querySelector("[data-agma-book]")?.value || form.elements.barangay?.value || "");
                    await loadAgmaBookOptions(area, currentBook);
                    agmaPage = 1;
                    await generateIds(true).catch(() => null);
                    captureAgmaSettings();
                    loadAgmaRecords(1);
                    return;
                }
                if (target.matches("[data-agma-book]")) {
                    syncAgmaSelectionsToMain();
                    captureAgmaSettings();
                    agmaPage = 1;
                    loadAgmaRecords(1);
                    return;
                }
                if (target.matches("[data-agma-paper-size], [data-agma-orientation]")) {
                    captureAgmaSettings();
                    return;
                }
                if (target.matches("[data-agma-layout]")) {
                    captureAgmaSettings();
                    return;
                }
                if (target.matches("[data-agma-venue], [data-agma-remarks], [data-agma-row-height], [data-agma-column-font], [data-agma-column-weight]")) {
                    captureAgmaSettings();
                }
            });

            toolBody.addEventListener("click", (event) => {
                if (event.target.closest("[data-agma-prev]")) {
                    if (agmaPage > 1) {
                        agmaPage--;
                        loadAgmaRecords(agmaPage);
                    }
                    return;
                }
                if (event.target.closest("[data-agma-next]")) {
                    if (agmaPage < agmaTotalPages) {
                        agmaPage++;
                        loadAgmaRecords(agmaPage);
                    }
                    return;
                }
                if (event.target.closest("[data-agma-print]")) {
                    printAgmaRoster().catch((error) => {
                        document.getElementById("save-message").textContent = error?.message || "Unable to print AGMA.";
                    });
                    return;
                }
                if (event.target.closest("[data-agma-print-cancel]")) {
                    closeAgmaPrintModal();
                }
            });

            toolModal.addEventListener("click", (event) => {
                if (event.target === toolModal) return;
            });

            document.addEventListener("keydown", (event) => {
                if (event.key === "Escape" && toolModal.classList.contains("open")) {
                    closeToolModal();
                }
                if (event.key === "Escape" && document.getElementById("membership-map-modal").classList.contains("open")) {
                    mapCloseModal();
                }
                if (event.key === "Escape" && document.getElementById("member-list-drawer").classList.contains("open")) {
                    document.getElementById("member-list-drawer").classList.remove("open");
                    document.getElementById("member-list-drawer").setAttribute("aria-hidden", "true");
                }
            });

            document.getElementById("draft-list").addEventListener("click", (event) => {
                const row = event.target.closest("[data-draft-index]");
                if (!row) return;
                const record = readDrafts()[Number(row.dataset.draftIndex)];
                setValues(record);
                document.getElementById("draft-number").textContent = record.memberId || record.draftNumber || "Generate ID";
                document.getElementById("save-message").textContent = "Draft loaded.";
            });

            document.getElementById("member-list-toggle-btn").addEventListener("click", () => {
                const drawer = document.getElementById("member-list-drawer");
                drawer.classList.toggle("open");
                drawer.setAttribute("aria-hidden", drawer.classList.contains("open") ? "false" : "true");
                if (drawer.classList.contains("open")) {
                    loadMemberList();
                }
            });
            document.getElementById("member-list-close-btn").addEventListener("click", () => {
                const drawer = document.getElementById("member-list-drawer");
                drawer.classList.remove("open");
                drawer.setAttribute("aria-hidden", "true");
            });
            document.getElementById("member-list-refresh-btn").addEventListener("click", () => {
                memberListPage = 1;
                loadMemberList();
            });
            document.getElementById("member-list-prev-btn").addEventListener("click", () => {
                if (memberListPage > 1) {
                    memberListPage--;
                    loadMemberList();
                }
            });
            document.getElementById("member-list-next-btn").addEventListener("click", () => {
                if (memberListPage < memberListTotalPages) {
                    memberListPage++;
                    loadMemberList();
                }
            });
            document.getElementById("member-list-day").addEventListener("change", () => {
                memberListPage = 1;
                loadMemberList();
            });
            document.getElementById("member-list-area").addEventListener("change", () => {
                memberListPage = 1;
                loadMemberList();
            });
            document.getElementById("member-list-month").addEventListener("change", () => {
                memberListPage = 1;
                loadMemberList();
            });
            document.getElementById("member-list-year").addEventListener("change", () => {
                memberListPage = 1;
                loadMemberList();
            });
            document.getElementById("member-list-status").addEventListener("change", () => {
                if (document.getElementById("member-list-status").value === "ALL_MONTHS_PENDING") {
                    document.getElementById("member-list-month").value = "0";
                }
                memberListPage = 1;
                loadMemberList();
            });
            document.getElementById("member-list-rows").addEventListener("click", (event) => {
                const deleteBtn = event.target.closest("[data-member-delete]");
                if (deleteBtn) {
                    const account = String(deleteBtn.getAttribute("data-member-delete") || "").trim();
                    if (account) deleteMemberFromList(account);
                    return;
                }
                const row = event.target.closest("[data-member-account]");
                if (!row) return;
                const account = String(row.getAttribute("data-member-account") || "").trim();
                if (!account) return;
                loadMemberFromList(account);
            });

            document.getElementById("map-pin-btn").addEventListener("click", async () => {
                try {
                    await mapInitForCurrentMember();
                } catch (error) {
                    document.getElementById("save-message").textContent = error?.message || "Unable to open map.";
                }
            });
            window.__membershipOpenMap = async function __membershipOpenMap() {
                try {
                    await mapInitForCurrentMember();
                } catch (error) {
                    document.getElementById("save-message").textContent = error?.message || "Unable to open map.";
                }
            };
            document.getElementById("map-close-btn").addEventListener("click", mapCloseModal);
            document.getElementById("focus-next-btn").addEventListener("click", focusNextRequiredField);
            document.getElementById("membership-map-modal").addEventListener("click", (event) => {
                if (event.target.id === "membership-map-modal") mapCloseModal();
            });
            window.addEventListener("message", (event) => {
                const msg = event.data || {};
                if (msg.source !== "membership-map") return;
                if (msg.type === "ready") {
                    mapFrameReady = true;
                    if (document.getElementById("membership-map-modal").classList.contains("open")) {
                        mapInitForCurrentMember();
                    }
                    return;
                }
                if (msg.type === "pin") {
                    mapSetLatLng(msg.lat || "-", msg.lng || "-");
                    return;
                }
                if (msg.type === "landmark-change") {
                    mapLandmark = String(msg.landmark || "").trim();
                    return;
                }
                if (msg.type === "reset-pin") {
                    mapResetPin();
                    return;
                }
                if (msg.type === "save") {
                    // Keep the latest filenames from the iframe, then write the final map record.
                    mapLandmark = String(msg.landmark || mapLandmark || "").trim();
                    mapTopImage = String(msg.topImage || mapTopImage || "").trim();
                    mapStreetImage = String(msg.streetImage || mapStreetImage || "").trim();
                    mapSaveCurrent();
                    return;
                }
                if (msg.type === "close") {
                    mapCloseModal();
                    return;
                }
                if (msg.type === "capture-saved") {
                    // Each capture sends back the saved filename so the modal can show what was stored.
                    if (msg.kind === "street") {
                        mapStreetImage = String(msg.filename || "").trim();
                    }
                    if (msg.kind === "top") {
                        mapTopImage = String(msg.filename || "").trim();
                    }
                    document.getElementById("save-message").textContent = msg.path
                        ? `Image saved on server: ${msg.path}`
                        : `Image saved: ${msg.filename || "capture.png"}`;
                    return;
                }
                if (msg.type === "capture-folder-ready") {
                    document.getElementById("save-message").textContent = `Save folder ready: ${msg.folder || "member_map"}`;
                    return;
                }
                if (msg.type === "capture-error") {
                    document.getElementById("save-message").textContent = msg.message || "Capture failed.";
                }
            });
            mapFrame?.addEventListener("load", () => {
                mapFrameReady = false;
            });

            toolBody.addEventListener("click", (event) => {
                const skipBtn = event.target.closest("[data-fees-skip]");
                if (skipBtn && toolTitle.textContent === "Fees") {
                    const memberId = form.elements.accountNumber?.value || form.elements.memberId?.value || "";
                    // No fees for this project - save every card at zero so TotalAmount = 0
                    // but the account still advances past "For Fees" in the workflow queue.
                    membershipFetch(`${MEMBERSHIP_API}?action=save_fees`, {
                        method: "POST",
                        credentials: "same-origin",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({ memberId, fees: {} })
                    }).then((r) => r.json()).then((result) => {
                        document.getElementById("save-message").textContent = result.message || "No fees required — advanced to order.";
                        if (result.ok) {
                            baseFees = baseFees.map((fee) => ({ label: fee.label, amount: 0 }));
                            otherFees = [];
                            feesRecordId = result.id || null;
                            syncFeesUpdateButton();
                            updateFeesTotals();
                        }
                    }).catch(() => {
                        document.getElementById("save-message").textContent = "Unable to skip fees.";
                    });
                    return;
                }

                const saveBtn = event.target.closest(".fee-save:not([data-add-other-fee]):not([data-fees-update]):not([data-fees-skip])");
                if (saveBtn && toolTitle.textContent === "Fees") {
                    const formData = values();
                    const memberId = form.elements.accountNumber?.value || form.elements.memberId?.value || "";
                    const feesPayload = {};
                    baseFees.forEach((fee) => {
                        feesPayload[fee.label] = Number(fee.amount || 0).toFixed(2);
                    });
                    otherFees.forEach((fee) => {
                        feesPayload[`Other_${fee.label}`] = Number(fee.amount || 0).toFixed(2);
                    });
                    rememberBaseFees(baseFees);
                    membershipFetch(`${MEMBERSHIP_API}?action=save_fees`, {
                        method: "POST",
                        credentials: "same-origin",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({ memberId, fees: feesPayload })
                    }).then((r) => r.json()).then((result) => {
                        document.getElementById("save-message").textContent = result.message || "Fees saved.";
                        if (result.ok) {
                            feesRecordId = result.id || null;
                            syncFeesUpdateButton();
                        }
                    }).catch(() => {
                        document.getElementById("save-message").textContent = "Unable to save fees.";
                    });
                    return;
                }

                const updateBtn = event.target.closest("[data-fees-update]");
                if (updateBtn && toolTitle.textContent === "Fees") {
                    // mempayments holds one row per account, so SAVE already upserts -
                    // UPDATE is the same call, just labeled for a member that's already saved.
                    const memberId = form.elements.accountNumber?.value || form.elements.memberId?.value || "";
                    const feesPayload = {};
                    baseFees.forEach((fee) => {
                        feesPayload[fee.label] = Number(fee.amount || 0).toFixed(2);
                    });
                    otherFees.forEach((fee) => {
                        feesPayload[`Other_${fee.label}`] = Number(fee.amount || 0).toFixed(2);
                    });
                    rememberBaseFees(baseFees);
                    membershipFetch(`${MEMBERSHIP_API}?action=save_fees`, {
                        method: "POST",
                        credentials: "same-origin",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({ memberId, fees: feesPayload })
                    }).then((r) => r.json()).then((result) => {
                        document.getElementById("save-message").textContent = result.message || "Fees updated.";
                        if (result.ok) {
                            feesRecordId = result.id || null;
                            syncFeesUpdateButton();
                        }
                    }).catch(() => {
                        document.getElementById("save-message").textContent = "Unable to update fees.";
                    });
                    return;
                }

                const profileCaptureBtn = event.target.closest("[data-profile-capture]");
                if (profileCaptureBtn) {
                    profileCaptureFrame().then(() => {
                        profileStatus("Photo captured. Click SAVE to store.");
                        document.getElementById("save-message").textContent = "Photo captured. Click SAVE to store.";
                    }).catch((error) => {
                        profileStatus(error.message || "Capture failed.", true);
                        document.getElementById("save-message").textContent = error.message || "Capture failed.";
                    });
                    return;
                }

                const profileSaveBtn = event.target.closest("[data-profile-save]");
                if (profileSaveBtn) {
                    profileSaveBtn.disabled = true;
                    profileSavePhoto().then(() => {
                        profileSaveBtn.disabled = false;
                    }).catch((error) => {
                        profileStatus(error.message || "Unable to save customer photo.", true);
                        document.getElementById("save-message").textContent = error.message || "Unable to save customer photo.";
                        profileSaveBtn.disabled = false;
                    });
                    return;
                }

                const profileCameraSelect = event.target.closest("[data-profile-camera-select]");
                if (profileCameraSelect && toolTitle.textContent === "Profile Picture Member") {
                    profileCameraDeviceId = String(profileCameraSelect.value || "");
                    profileStartCamera(profileCameraDeviceId).catch((error) => {
                        profileStatus(error.message || "Unable to switch camera.", true);
                    });
                    return;
                }

                const agmaExportExcelBtn = event.target.closest("[data-agma-export-excel]");
                if (agmaExportExcelBtn) {
                    const payload = agmaCurrentPayload();
                    agmaExportExcelBtn.disabled = true;
                    try {
                        const filteredRows = filterAgmaRows(agmaEligibleRows(Array.isArray(agmaRows) ? agmaRows.slice() : []));
                        const workbookHtml = buildAgmaBackupExcelHtml(filteredRows, payload);
                        const fileStamp = new Date().toISOString().slice(0, 10);
                        downloadAgmaTextFile(`AGMA_Backup_${fileStamp}.xls`, workbookHtml, "application/vnd.ms-excel");
                        document.getElementById("save-message").textContent = "Excel backup downloaded.";
                    } catch (_error) {
                        document.getElementById("save-message").textContent = "Unable to export Excel backup.";
                    } finally {
                        agmaExportExcelBtn.disabled = false;
                    }
                    return;
                }

                const agmaCloseBtn = event.target.closest("[data-agma-close]");
                if (agmaCloseBtn) {
                    closeToolModal();
                    return;
                }

                const agmaSettingsToggle = event.target.closest("[data-agma-settings-toggle]");
                if (agmaSettingsToggle) {
                    const panel = toolBody.querySelector("[data-agma-settings-panel]");
                    if (panel) panel.classList.toggle("is-hidden");
                    return;
                }

                const reportExportBtn = event.target.closest("[data-report-export]");
                if (reportExportBtn) {
                    document.getElementById("save-message").textContent = "Generating membership report...";
                    return;
                }

                const reportCloseBtn = event.target.closest("[data-report-close]");
                if (reportCloseBtn) {
                    closeReportGroupDetail();
                    closeToolModal();
                    return;
                }

                const reportRefreshBtn = event.target.closest("[data-report-refresh]");
                if (reportRefreshBtn) {
                    reportPage = 1;
                    loadReportRows();
                    return;
                }

                const reportPrintBtn = event.target.closest("[data-report-print]");
                if (reportPrintBtn) {
                    printReportRows();
                    return;
                }

                const reportClearBtn = event.target.closest("[data-report-clear]");
                if (reportClearBtn) {
                    const searchField = toolBody.querySelector("[data-report-search]");
                    const areaField = toolBody.querySelector("[data-report-area]");
                    const bookField = toolBody.querySelector("[data-report-book]");
                    const columnField = toolBody.querySelector("[data-report-columns]");
                    if (searchField) searchField.value = "";
                    if (areaField) areaField.value = "ALL";
                    if (bookField) bookField.value = "ALL";
                    if (columnField) columnField.value = "# AC";
                    reportActiveClass = "Residential";
                    toolBody.querySelectorAll("[data-report-class-chip]").forEach((button) => {
                        button.classList.toggle("is-active", String(button.getAttribute("data-report-class-chip") || "") === reportActiveClass);
                    });
                    reportPage = 1;
                    loadReportRows();
                    return;
                }

                const reportClassChip = event.target.closest("[data-report-class-chip]");
                if (reportClassChip) {
                    reportActiveClass = String(reportClassChip.getAttribute("data-report-class-chip") || "ALL").trim() || "ALL";
                    toolBody.querySelectorAll("[data-report-class-chip]").forEach((button) => {
                        button.classList.toggle("is-active", button === reportClassChip);
                    });
                    reportPage = 1;
                    loadReportRows();
                    return;
                }

                if (event.target.closest("[data-report-prev]")) {
                    if (reportPage > 1) {
                        reportPage--;
                        loadReportRows();
                    }
                    return;
                }

                if (event.target.closest("[data-report-next]")) {
                    if (reportPage < reportTotalPages) {
                        reportPage++;
                        loadReportRows();
                    }
                    return;
                }

                const addButton = event.target.closest("[data-add-other-fee]");
                if (addButton) {
                    const labelField = toolBody.querySelector("[data-other-fee-label]");
                    const amountField = toolBody.querySelector("[data-other-fee-amount]");
                    const label = String(labelField?.value || "").trim();
                    const amount = Number(String(amountField?.value || "").replace(/,/g, ""));
                    if (!label || Number.isNaN(amount) || amount <= 0) {
                        document.getElementById("save-message").textContent = "Enter valid other fee label and amount.";
                        return;
                    }
                    otherFees.push({ label, amount });
                    if (labelField) labelField.value = "";
                    if (amountField) amountField.value = "";
                    updateFeesTotals();
                    document.getElementById("save-message").textContent = "Other fee added.";
                    return;
                }

                const clearBaseFeeButton = event.target.closest("[data-base-fee-clear]");
                if (clearBaseFeeButton) {
                    const index = Number(clearBaseFeeButton.getAttribute("data-base-fee-clear"));
                    if (Number.isInteger(index) && baseFees[index]) {
                        baseFees[index].amount = 0;
                        const fieldsWrap = toolBody.querySelector("[data-fees-fields]");
                        if (fieldsWrap) fieldsWrap.innerHTML = feeCards();
                        updateFeesTotals();
                    }
                    return;
                }

                const removeFeeButton = event.target.closest("[data-other-fee-remove]");
                if (removeFeeButton) {
                    const index = Number(removeFeeButton.getAttribute("data-other-fee-remove"));
                    if (Number.isInteger(index) && index >= 0 && index < otherFees.length) {
                        otherFees.splice(index, 1);
                        updateFeesTotals();
                        document.getElementById("save-message").textContent = "Other fee removed.";
                    }
                    return;
                }

                if (event.target.closest("[data-jo-refresh]")) {
                    joPage = 1;
                    loadJobOrders();
                    return;
                }

                if (event.target.closest("[data-jo-prev]")) {
                    if (joPage > 1) {
                        joPage--;
                        loadJobOrders();
                    }
                    return;
                }

                if (event.target.closest("[data-jo-next]")) {
                    if (joPage < joTotalPages) {
                        joPage++;
                        loadJobOrders();
                    }
                    return;
                }

                const openBtn = event.target.closest("[data-jo-open]");
                if (openBtn) {
                    openJobOrderDetail(openBtn.getAttribute("data-jo-open") || "");
                    return;
                }

                if (event.target.closest("[data-jo-print]")) {
                    printJobOrderDetail(currentJobOrderDetail);
                    return;
                }

                if (event.target.closest("[data-jo-settings]")) {
                    const card = toolBody.querySelector(".jo-detail-card");
                    const panel = card?.querySelector("[data-approver-panel]");
                    const settingsBtn = toolBody.querySelector("[data-jo-settings]");
                    if (panel) {
                        initPrintApproverPanel(card, () => {
                            const preview = toolBody.querySelector("[data-jo-print-preview]");
                            if (preview && currentJobOrderDetail) preview.srcdoc = buildJobOrderPrintHtml(currentJobOrderDetail);
                        });
                        panel.hidden = !panel.hidden;
                        settingsBtn?.classList.toggle("is-active", !panel.hidden);
                    }
                    return;
                }

                if (event.target.closest("[data-jo-detail-close]")) {
                    toolBody.querySelector("[data-jo-detail-modal]")?.classList.remove("open");
                    return;
                }

                if (event.target.matches("[data-jo-detail-modal]")) {
                    event.target.classList.remove("open");
                }
            });

            form.addEventListener("input", (event) => {
                const target = event.target;
                if (!(target instanceof HTMLInputElement || target instanceof HTMLSelectElement || target instanceof HTMLTextAreaElement)) return;
                if (!target.classList.contains("member-input") && !target.classList.contains("member-select") && !target.classList.contains("member-textarea")) return;
                const value = String(target.value || "").trim();
                target.classList.toggle("prefilled", value !== "");
            });

            toolBody.addEventListener("wheel", (event) => {
                const shell = event.target.closest("[data-jo-zoom-shell]");
                if (!shell) return;
                event.preventDefault();
                const next = joDetailZoom + (event.deltaY < 0 ? 0.08 : -0.08);
                joDetailZoom = Math.max(0.45, Math.min(1.9, next));
                const content = toolBody.querySelector("[data-jo-zoom-content]");
                if (content) content.style.transform = `translate(${joPanX}px, ${joPanY}px) scale(${joDetailZoom})`;
            }, { passive: false });

            toolBody.addEventListener("mousedown", (event) => {
                const shell = event.target.closest("[data-jo-zoom-shell]");
                if (!shell || event.button !== 0) return;
                joDragActive = true;
                joDragStartX = event.clientX;
                joDragStartY = event.clientY;
                joPanStartX = joPanX;
                joPanStartY = joPanY;
                shell.classList.add("dragging");
                event.preventDefault();
            });

            document.addEventListener("mousemove", (event) => {
                if (!joDragActive) return;
                joPanX = joPanStartX + (event.clientX - joDragStartX);
                joPanY = joPanStartY + (event.clientY - joDragStartY);
                const content = toolBody.querySelector("[data-jo-zoom-content]");
                if (content) content.style.transform = `translate(${joPanX}px, ${joPanY}px) scale(${joDetailZoom})`;
            });

            document.addEventListener("mouseup", () => {
                if (!joDragActive) return;
                joDragActive = false;
                toolBody.querySelector("[data-jo-zoom-shell]")?.classList.remove("dragging");
            });

            toolBody.addEventListener("change", (event) => {
                if (event.target.matches("[data-report-area], [data-report-book], [data-report-columns]")) {
                    reportPage = 1;
                    loadReportRows();
                    return;
                }
                if (event.target.matches("[data-jo-year], [data-jo-month], [data-jo-status], [data-jo-area]")) {
                    joPage = 1;
                    loadJobOrders();
                }
            });

            toolBody.addEventListener("input", (event) => {
                const baseAmountInput = event.target.closest("[data-base-fee-amount]");
                if (baseAmountInput) {
                    const index = Number(baseAmountInput.getAttribute("data-base-fee-amount"));
                    if (Number.isInteger(index) && baseFees[index]) {
                        baseFees[index].amount = Number(String(baseAmountInput.value || "").replace(/,/g, "")) || 0;
                        const filled = baseFees[index].amount !== 0;
                        const card = baseAmountInput.closest(".fee-input");
                        if (card) {
                            card.classList.toggle("is-filled", filled);
                            let clearBtn = card.querySelector("[data-base-fee-clear]");
                            if (filled && !clearBtn) {
                                clearBtn = document.createElement("button");
                                clearBtn.type = "button";
                                clearBtn.className = "fee-clear";
                                clearBtn.title = "Clear";
                                clearBtn.setAttribute("data-base-fee-clear", String(index));
                                clearBtn.setAttribute("aria-label", `Clear ${baseFees[index].label}`);
                                clearBtn.innerHTML = "&times;";
                                card.appendChild(clearBtn);
                            } else if (!filled && clearBtn) {
                                clearBtn.remove();
                            }
                        }
                        updateFeesTotals();
                    }
                    return;
                }
                if (event.target.matches("[data-agma-search]")) {
                    agmaSearchTerm = String(event.target.value || "").trim();
                    captureAgmaSettings();
                    agmaPage = 1;
                    renderAgmaCurrentPage();
                    return;
                }
                if (event.target.matches("[data-agma-print-title], [data-agma-print-date], [data-agma-margin-left], [data-agma-margin-right], [data-agma-venue], [data-agma-remarks], [data-agma-row-height], [data-agma-column-font], [data-agma-column-weight]")) {
                    captureAgmaSettings();
                    return;
                }
                if (event.target.matches("[data-report-search]")) {
                    reportPage = 1;
                    loadReportRows();
                }
            });

            toolBody.addEventListener("focusin", (event) => {
                const input = event.target;
                if (!(input instanceof HTMLInputElement)) return;
                if (input.matches("[data-base-fee-amount], [data-other-fee-amount]")) {
                    input.select();
                }
            });

            toolBody.addEventListener("focusout", (event) => {
                const input = event.target;
                if (!(input instanceof HTMLInputElement)) return;
                if (!input.closest(".fees-workspace")) return;
                if (input.matches("[data-other-fee-label], [data-base-fee-amount]")) return;
                if (String(input.value || "").trim() === "") {
                    input.value = "0.00";
                    input.dispatchEvent(new Event("input", { bubbles: true }));
                }
            });

            renderDrafts();
            updateSmartReview();
            document.getElementById("member-list-day").innerHTML = memberListDayOptions();
            document.getElementById("member-list-month").innerHTML = memberListMonthOptions();
            document.getElementById("member-list-year").innerHTML = memberListYearOptions();
            document.getElementById("member-list-month").value = String(new Date().getMonth() + 1);
            document.getElementById("member-list-year").value = String(new Date().getFullYear());
            loadPendingCount(new Date().getMonth() + 1, new Date().getFullYear());
            (async function initMembershipData() {
                // Load this independent list first; the legacy area/book API may respond slowly.
                loadElectricianOptions(form.elements.electrician.value);
                await memberLocalDb().catch(() => null);
                await memberSyncQueuedCreates();
                await loadAreaOptions(form.elements.area.value || "001 - CATBALOGAN");
                await loadBookOptions(form.elements.barangay.value, false, getMainMemberAreaValue());
                generateIds(true);
            })();
            window.addEventListener("online", () => {
                memberSyncQueuedCreates();
            });
            window.setInterval(() => {
                memberSyncQueuedCreates();
            }, 30000);
            // ponytail: lets other modules (e.g. Complaints' "edit consumer" link) hand off an
            // account number and land here pre-filled, reusing the same tested lookup the
            // member-list drawer already uses instead of a second, untested fill path.
            (function prefillFromQuery() {
                const account = new URLSearchParams(location.search).get("account");
                if (account) loadMemberFromList(account);
            })();
        })();
    </script>
    <script src="../../../assets/js/offline-sync.js?v=20260820-sw-registration-fix-v10"></script>
</body>
</html>

