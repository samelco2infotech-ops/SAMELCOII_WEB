                                    </label>
                                    <label class="modal-field">
                                        <span>Margin Left (in)</span>
                                        <input data-agma-margin-left type="number" min="0" max="2" step="0.05" value="${escapeHtml(String((data.pageMargins && data.pageMargins.left) ?? AGMA_PAGE_MARGIN_DEFAULTS.left))}" />
