                                        ${["Select book", ...getCurrentBookOptions()].map((option) => `<option${option === String(data.barangay || "Select book") ? " selected" : ""}>${escapeHtml(option)}</option>`).join("")}
                                    </select>
                                </label>
                            </div>
                            <div class="agma-legacy-settings is-hidden" data-agma-settings-panel>
                                <div class="agma-settings-grid">
                                    <label class="modal-field">
                                        <span>Print Title</span>
                                        <input data-agma-print-title type="text" value="${escapeHtml(String(data.printTitle || "SAMELCO II 47th Annual General Membership Assembly"))}" placeholder="SAMELCO II 47th Annual General Membership Assembly" />
