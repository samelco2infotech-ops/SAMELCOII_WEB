                                <span class="jo-pill">Live Queue</span>
                                <button class="jo-head-close" data-jo-close type="button" aria-label="Close Job Order">×</button>
                            </div>
                            <div class="jo-toolbar">
                                <label class="jo-field"><span>Search</span><input data-jo-search value="" placeholder="Account / Applicant" /></label>
                                <label class="jo-field"><span>Year</span><select data-jo-year><option${year === 2026 ? " selected" : ""}>2026</option><option${year === 2025 ? " selected" : ""}>2025</option><option${year === 2024 ? " selected" : ""}>2024</option></select></label>
                                <label class="jo-field"><span>Month</span><select data-jo-month><option value="0">All months · pending</option><option${month === "January" ? " selected" : ""}>January</option><option${month === "February" ? " selected" : ""}>February</option><option${month === "March" ? " selected" : ""}>March</option><option${month === "April" ? " selected" : ""}>April</option><option${month === "May" ? " selected" : ""}>May</option><option${month === "June" ? " selected" : ""}>June</option><option${month === "July" ? " selected" : ""}>July</option><option${month === "August" ? " selected" : ""}>August</option><option${month === "September" ? " selected" : ""}>September</option><option${month === "October" ? " selected" : ""}>October</option><option${month === "November" ? " selected" : ""}>November</option><option${month === "December" ? " selected" : ""}>December</option></select></label>
                <label class="jo-field"><span>Area</span><select data-jo-area><option selected>ALL</option><option>MAIN</option><option>CATBALOGAN</option><option>VILLAREAL</option><option>BASEY</option></select></label>
                                <label class="jo-field"><span>Status</span><select data-jo-status><option>ALL</option><option selected>PENDING</option><option>ENERGIZED</option></select></label>
                                <button class="jo-btn" data-jo-refresh type="button">REFRESH</button>
                            </div>
                            <div class="jo-scope" data-jo-scope></div>
                            <div class="jo-list" data-jo-list></div>
                            <div class="jo-pager" data-jo-pager></div>
                            <div class="jo-detail-modal" data-jo-detail-modal>
                                <section class="jo-detail-card">
                                    <div class="jo-detail-head">
                                        <div>
                                            <h4>Service Connection Order Preview</h4>
                                            <div class="jo-zoom-note">Mouse wheel to zoom in/out</div>
                                        </div>
                                        <div class="jo-detail-actions">
                                            <button class="jo-page-btn jo-settings-btn" data-jo-settings type="button" title="Change signatories" aria-label="Change signatories">${ICON_GEAR_SVG}</button>
                                            <button class="jo-page-btn" data-jo-print type="button">Print</button>
                                            <button class="jo-page-btn" data-jo-detail-close type="button">Close</button>
                                        </div>
                                    </div>
                                    ${buildPrintApproverPanel()}
