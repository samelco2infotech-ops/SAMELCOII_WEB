                                            ${AGMA_LAYOUT_MODE_OPTIONS.map((option) => `<option${normalizeAgmaLayoutMode(data.layoutMode || "Auto") === option.value ? " selected" : ""}>${escapeHtml(option.label)}</option>`).join("")}
                                        </select>
