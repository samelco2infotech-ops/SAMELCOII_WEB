                                </section>
                            </div>
                        </div>
                    `;
                }
                if (name === "Agma") {
                    return `
                        <div class="agma-legacy-shell">
                            <div class="agma-legacy-topbar">
                                <strong>AGMA</strong>
                                <div style="display:flex; gap:8px; align-items:center;">
                                    <button class="settings" type="button" data-agma-settings-toggle aria-label="AGMA settings">&#9881;</button>
                                    <button class="close" type="button" data-agma-close aria-label="Close AGMA">X</button>
                                </div>
